APP_ENV=production
APP_URL=https://api.buildmanagement.id/ternaku
ALLOWED_ORIGINS=https://ternaku.rstudiohub.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ternaku
DB_USER=ternaku
DB_PASSWORD=replace-with-strong-password
# Sessions renew for 30 days of activity, with a maximum of 90 days per login.
# Set a random secret of at least 32 characters to allow the owner to create the first admin.
# Empty disables first-admin web setup. Employee registrations still remain available afterward.
SETUP_TOKEN=
